# =================================
# TEST ENVIRONMENT CONFIGURATION
# =================================

# Groq API Configuration - Test
GROQ_API_KEY=your_test_groq_api_key_here

# MongoDB Configuration - Test (In-Memory or Test DB)
SPRING_DATA_MONGODB_HOST=localhost
SPRING_DATA_MONGODB_PORT=27017
SPRING_DATA_MONGODB_DATABASE=codeAnalyzer_test
SPRING_DATA_MONGODB_USERNAME=test_user
SPRING_DATA_MONGODB_PASSWORD=test_password
SPRING_DATA_MONGODB_AUTHENTICATION_DATABASE=codeAnalyzer_test

# External Services - Test Environment
EXTERNAL_OLLAMA_BASE_URL=http://localhost:11434
EXTERNAL_CHROMA_BASE_URL=http://localhost:8000
EXTERNAL_CHROMA_TENANT=test_tenant
EXTERNAL_CHROMA_DATABASE=test_database

# Security - Test API Key
SECURITY_API_KEY_KEY=codeanalyzer_test_api_key_12345

# Test-specific flags
DEBUG_MODE=true
ENABLE_DETAILED_LOGGING=true