# =================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# =================================

# Application
SPRING_PROFILES_ACTIVE=development
SERVER_PORT=8080

# Database - H2 In-Memory (Development)
SPRING_DATASOURCE_URL=jdbc:h2:mem:devdb;DB_CLOSE_DELAY=-1
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=dev_password
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect
SPRING_JPA_HIBERNATE_DDL_AUTO=create-drop
SPRING_JPA_SHOW_SQL=true

# MongoDB - Development (No Authentication for local development)
SPRING_DATA_MONGODB_HOST=localhost
SPRING_DATA_MONGODB_PORT=27017
SPRING_DATA_MONGODB_DATABASE=codeAnalyzer_dev
# Commented out authentication for local development
# SPRING_DATA_MONGODB_USERNAME=dev_user
# SPRING_DATA_MONGODB_PASSWORD=dev_password
# SPRING_DATA_MONGODB_AUTHENTICATION_DATABASE=codeAnalyzer_dev

# External Services - Local Development
EXTERNAL_OLLAMA_BASE_URL=http://localhost:11434
EXTERNAL_OLLAMA_EMBEDDING_MODEL=unclemusclez/jina-embeddings-v2-base-code:latest
EXTERNAL_OLLAMA_LLM_MODEL=codellama:7b-instruct
EXTERNAL_OLLAMA_SLM_MODEL=phi3:3.8b
EXTERNAL_OLLAMA_TIMEOUT=120s

EXTERNAL_CHROMA_BASE_URL=http://localhost:8000
EXTERNAL_CHROMA_COLLECTION_NAME=java-code-repo-dev
EXTERNAL_CHROMA_TIMEOUT=30s
EXTERNAL_CHROMA_TENANT=dev_tenant
EXTERNAL_CHROMA_DATABASE=dev_database

# Workspace Configuration - Development
APP_WORKSPACE_DIRECTORY=./workspace-dev
APP_WORKSPACE_MAX_REPOSITORIES=10
APP_WORKSPACE_CLEANUP_ON_STARTUP=true

# Processing - Relaxed limits for development
PROCESSING_MAX_FILE_SIZE=2MB
PROCESSING_MAX_CONCURRENT_FILES=3
PROCESSING_CHUNK_SIZE=1000
PROCESSING_CHUNK_OVERLAP=200

# Chat Configuration
CHAT_AGENT_ENABLED=true
CHAT_AGENT_SESSION_TIMEOUT=3600000
CHAT_AGENT_MAX_SESSIONS=50
CHAT_FORCE_PATTERN_MATCHING=false
CHAT_USE_PATTERN_MATCHING=true
CHAT_WAIT_FOR_COMPLETION=false

# Logging - Verbose for development
LOGGING_LEVEL_COM_SUHAS_CODEANALYZER=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOGGING_LEVEL_ORG_ECLIPSE_JGIT=WARN
LOGGING_LEVEL_COM_SUHAS_CODEANALYZER_CHAT=DEBUG

# Management Endpoints - All exposed for debugging
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,env,configprops
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# 🔑 API Key Authentication Configuration (ENABLED for testing)
SECURITY_API_KEY_ENABLED=true
SECURITY_API_KEY_KEY=codeanalyzer_dev_8VzG9UsCbmVM5CF4qMz92gv4eIQvzT
SECURITY_API_KEY_HEADER_NAME=X-API-Key

# 🌐 CORS Configuration (Frontend Integration)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# Swagger UI - Enabled for development
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui
SPRINGDOC_API_DOCS_ENABLED=true

# LLM Provider Configuration - Development  
LLM_PROVIDER=groq

# Groq API Configuration - Development
GROQ_API_KEY=${GROQ_API_KEY}
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_MODEL=llama-3.1-8b-instant
GROQ_API_TEMPERATURE=0.1
GROQ_API_MAX_TOKENS=2048
GROQ_API_TIMEOUT=30s

# Development flags
DEBUG_MODE=true
ENABLE_DETAILED_LOGGING=true