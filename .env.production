# =================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =================================

# Groq API Configuration - Production
GROQ_API_KEY=your_production_groq_api_key_here

# MongoDB Configuration - Production
SPRING_DATA_MONGODB_HOST=your_prod_mongo_host
SPRING_DATA_MONGODB_PORT=27017
SPRING_DATA_MONGODB_DATABASE=codeAnalyzer_prod
SPRING_DATA_MONGODB_USERNAME=prod_user
SPRING_DATA_MONGODB_PASSWORD=secure_prod_password
SPRING_DATA_MONGODB_AUTHENTICATION_DATABASE=codeAnalyzer_prod

# External Services - Production Environment
EXTERNAL_OLLAMA_BASE_URL=https://your-prod-ollama.com
EXTERNAL_CHROMA_BASE_URL=https://your-prod-chroma.com
EXTERNAL_CHROMA_TENANT=prod_tenant
EXTERNAL_CHROMA_DATABASE=prod_database

# Security - Production API Key
SECURITY_API_KEY_KEY=your_secure_production_api_key_here

# Production flags
DEBUG_MODE=false
ENABLE_DETAILED_LOGGING=false